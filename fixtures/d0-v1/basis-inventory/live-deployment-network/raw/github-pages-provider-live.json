        "text": "name: Validate and deploy registries\n\non:\n  pull_request:\n  push:\n    branches: [main]\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: pages-${{ github.ref }}\n  cancel-in-progress: true\n\njobs:\n  validate:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 45\n    steps:\n      - name: Check out registry catalog\n        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          persist-credentials: false\n      - name: Check out pinned indexer\n        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n        with:\n          repository: pkgre/pkgre\n          ref: ae1dfbfd4e965dffb538e356f005e4fbb32fdb77\n          path: tooling\n          persist-credentials: false\n      - name: Install Nix\n        uses: cachix/install-nix-action@13d8dd58da0234aa297dedd986986ccb8e7f3e24 # v31\n      - name: Build pinned indexer\n        run: nix build --print-build-logs ./tooling#indexer\n      - name: Require fully applied admissions\n        run: ./result/bin/pkgre-indexer check registry\n      - name: Require converged catalog\n        run: |\n          ./result/bin/pkgre-indexer lock registry\n          changes=\"$(git status --porcelain=v1 --untracked-files=all -- registry)\"\n          if [[ -n \"$changes\" ]]; then\n            printf '%s\\n' \"$changes\" >&2\n            echo \"registry is not fully applied and converged; run pkgre-indexer update-apply or lock and commit every result\" >&2\n            exit 1\n          fi\n      - name: Render and reproduce site\n        run: |\n          ./result/bin/pkgre-indexer render registry site\n          ./result/bin/pkgre-indexer verify registry site\n      - name: Verify monotonic publication\n        run: |\n          mkdir previous\n          curl --fail --silent --show-error --retry 3 https://rust.pkg.re/release.json --output previous/release.json\n          curl --fail --silent --show-error --retry 3 https://rust.pkg.re/downloads.json --output previous/downloads.json\n          ./result/bin/pkgre-indexer verify-monotonic previous site\n      - name: Add landing page\n        run: |\n          if grep -Eiq \"<(script|style)([[:space:]>])|[[:space:]](style|on[a-z]+)[[:space:]]*=|rel[[:space:]]*=[[:space:]]*[\\\"']?stylesheet\" index.html; then\n            echo \"index.html must not contain CSS or JavaScript\" >&2\n            exit 1\n          fi\n          install -m 0644 index.html site/index.html\n      - name: Add origin health canary\n        run: |\n          expected='pkgre-origin rust v1'\n          test \"$(cat origin-health/v1.txt)\" = \"$expected\"\n          test \"$(wc -c < origin-health/v1.txt)\" -eq 21\n          install -D -m 0644 origin-health/v1.txt site/origin-health/v1.txt\n          cmp origin-health/v1.txt site/origin-health/v1.txt\n      - name: Configure GitHub Pages\n        if: github.event_name == 'push' && github.ref == 'refs/heads/main'\n        uses: actions/configure-pages@983d7736d9b0ae728b81ab479565c72886d7745b # v5\n      - name: Archive Pages artifact\n        if: github.event_name == 'push' && github.ref == 'refs/heads/main'\n        run: |\n          tar \\\n            --dereference --hard-dereference \\\n            --directory site \\\n            -cvf \"$RUNNER_TEMP/artifact.tar\" \\\n            --exclude=.git \\\n            --exclude=.github \\\n            .\n      - name: Upload Pages artifact\n        if: github.event_name == 'push' && github.ref == 'refs/heads/main'\n        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\n        with:\n          name: github-pages\n          path: ${{ runner.temp }}/artifact.tar\n          retention-days: 1\n          if-no-files-found: error\n\n  deploy:\n    if: github.event_name == 'push' && github.ref == 'refs/heads/main'\n    needs: validate\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    permissions:\n      pages: write\n      id-token: write\n    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n    steps:\n      - name: Deploy to GitHub Pages\n        id: deployment\n        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4\n"
      },
