registry=http://127.0.0.1:48730/
audit=false
fund=false
save-exact=true
ignore-scripts=true
foreground-scripts=false
progress=false
offline=false
strict-npmrc=true
allow-directory=none
allow-file=none
allow-git=none
allow-remote=none
replace-registry-host=always
min-release-age=30
min-release-age-exclude[]=pkgre-js
